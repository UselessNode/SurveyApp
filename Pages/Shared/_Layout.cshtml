<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechStack Vote</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">
                <!-- ВСТАВЛЯЕМ АНИМИРОВАННЫЙ ЛОГОТИП СЮДА -->
                <a class="navbar-brand fw-bold animated-logo" asp-area="" asp-page="/Index">
                    <span class="logo-icon">🗳️</span>
                    <span class="logo-text">
                        <span class="ch">Г</span><span class="ch">О</span><span class="ch">Л</span><span class="ch">О</span><span class="ch">С</span><span class="ch">О</span><span class="ch">В</span><span class="ch">А</span><span class="ch">Н</span><span class="ch">И</span><span class="ch">Е</span>
                    </span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse justify-content-end">
                    <ul class="navbar-nav">
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Index">Голосование</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Stats">Результаты</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="main-content">
        @RenderBody()
    </div>

    <footer class="footer mt-auto py-3 bg-light text-center border-top">
        <div class="container">
            <span class="text-muted">© 2026 TechStack Survey.</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
