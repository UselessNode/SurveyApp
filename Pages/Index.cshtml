@page
@model IndexModel
@{
    ViewData["Title"] = "Голосование за стек";
}
<style>
    /* Убрали стили для body, чтобы не ломать Layout */

    .survey-wrapper {
        display: flex;
        justify-content: center;
        padding-top: 40px;
        padding-bottom: 40px;
        background-color: #f0f2f5; /* Фон перенесли сюда */
        min-height: calc(100vh - 150px); /* Чтобы футер был внизу */
    }

    .survey-container {
        background: white;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.05);
        width: 100%;
        max-width: 800px; /* Чуть шире для карточек стека */
    }

    /* Остальные стили (карточки, инпуты) оставляем как были */
    h2 { text-align: center; color: #2c3e50; margin-bottom: 25px; }
    .stack-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin: 20px 0; }
    .stack-option { position: relative; }
    .stack-option input { position: absolute; opacity: 0; cursor: pointer; height: 0; width: 0; }
    .stack-card {
        display: flex; align-items: center; justify-content: center;
        padding: 20px; border: 2px solid #e0e0e0; border-radius: 8px;
        cursor: pointer; transition: all 0.2s ease; font-weight: 600; text-align: center;
        background: #fff; height: 100%; min-height: 60px;
    }
    .stack-option:hover .stack-card { border-color: #3498db; background: #f7fbff; }
    .stack-option input:checked + .stack-card {
        border-color: #3498db; background: #ebf5fb; color: #2980b9;
        box-shadow: 0 0 0 2px #3498db inset;
    }
    .form-group { margin-bottom: 20px; }
    label { display: block; margin-bottom: 8px; font-weight: bold; color: #555; }
    input[type="text"], input[type="number"], textarea {
        width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px; box-sizing: border-box;
    }
    button.submit-btn {
        width: 100%; padding: 12px; background-color: #2ecc71; color: white; border: none;
        border-radius: 5px; font-size: 16px; cursor: pointer; transition: background 0.3s;
    }
    button.submit-btn:hover { background-color: #27ae60; }
    .success-msg { background: #d4edda; color: #155724; padding: 15px; border-radius: 5px; text-align: center; margin-top: 20px; }
</style>

<div class="survey-wrapper">
    <div class="survey-container">
        <h2>🗳️ Выбор технологического стека</h2>
        <p class="subtitle">Какой backend-фреймворк лучше всего подходит для новых проектов?</p>

        <form method="post">
            <div class="user-info">
                <div class="input-group">
                    <label>Ваше имя / Никнейм</label>
                    <input asp-for="Name" placeholder="Developer" required />
                </div>
                <div class="input-group" style="display: flex; flex-direction: column; gap: 5px;">
                    <label for="experienceSlider">
                        Опыт (лет): <strong id="sliderValue">@Model?.Age</strong>
                    </label>
                    
                    <input asp-for="Age" 
                        type="range" 
                        id="experienceSlider"
                        min="0" 
                        max="50" 
                        step="1" 
                        class="form-range"
                        oninput="document.getElementById('sliderValue').innerText = this.value" />
                </div>
            </div>

            <label style="font-weight: bold; display: block; margin-bottom: 10px;">Выберите один или несколько вариантов:</label>

            <div class="stack-grid">
                @foreach (var option in Model.AllOptions)
                {
                    <label class="stack-option">
                        <input type="checkbox"
                               name="SelectedOptionIds"
                               value="@option.Id"
                               @(Model.SelectedOptionIds.Contains(option.Id) ? "checked" : "") />
                        <div class="stack-card">@option.OptionText</div>
                    </label>
                }
            </div>

            <div class="input-group" style="margin-top: 20px;">
                <label>Почему вы выбрали именно это? (аргументы)</label>
                <textarea asp-for="Comments" rows="3" placeholder="Производительность, экосистема, простота..."></textarea>
            </div>

            <button type="submit" class="submit-btn">Проголосовать</button>
        </form>

        @if (Model.Message != null)
        {
            <div class="success-msg">@Model.Message</div>
        }
    </div>
</div>
